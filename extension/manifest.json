{
  "manifest_version": 3,
  "name": "VaultSync Autofill Companion",
  "version": "1.0.0",
  "description": "Secure on-demand credential autofill powered by VaultSync C++ Native Messaging",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "VaultSync"
  }
}
